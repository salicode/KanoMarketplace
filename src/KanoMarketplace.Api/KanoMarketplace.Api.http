
@host = http://localhost:5051
# For Azure use: @host = https://kano-api-salisu.azurewebsites.net

@adminPhone = +2348166667095
@adminEmail =salisuaminu615@gmail.com
@userPhone = +2348012345678


###############################################################
# ADMIN LOGIN  (the number set in Admin:PhoneNumber)
###############################################################

### A1. Request OTP for the admin
POST {{host}}/api/v1/auth/otp/request
Content-Type: application/json

@adminEmail =salisuaminu615@gmail.com
{ "phoneNumber": "{{adminPhone, adminEmail}}" }

### A2. Verify the admin OTP (put the code from the log here)
# @name adminLogin
POST {{host}}/api/v1/auth/otp/verify
Content-Type: application/json

{ "phoneNumber": "{{adminPhone}}", "code": "385916", "deviceId": "admin-laptop" }
### A1. Request OTP for the admin
POST {{host}}/api/v1/auth/otp/request
Content-Type: application/json

{
  "phoneNumber": "+2348166667095",
  "email": "salisuaminuyalwa@gmail.com"
}
### A2. Verify the admin OTP (put the code from the log here)

POST {{host}}/api/v1/auth/otp/verify
{ "phoneNumber": "+2348166667095", "email": "salisuaminu615@gmail.com", "code": "123456", "deviceId": "swagger" }

### A3. Admin test call
@adminToken = {{adminLogin.response.body.accessToken}}
GET {{host}}/api/v1/admin/dashboard
Authorization: Bearer {{adminToken}}

###############################################################
# NORMAL USER LOGIN  (customer; the account is created on first verify)
###############################################################

### U1. Request OTP for a user
POST {{host}}/api/v1/auth/otp/request
Content-Type: application/json

{ "phoneNumber": "{{userPhone}}" }

### U2. Verify the user OTP
# @name userLogin
POST {{host}}/api/v1/auth/otp/verify
Content-Type: application/json

{ "phoneNumber": "{{userPhone}}", "code": "PASTE_CODE", "deviceId": "user-phone-1" }

### U3. Check the profile
@userToken = {{userLogin.response.body.accessToken}}
GET {{host}}/api/v1/users/me
Authorization: Bearer {{userToken}}

### U4. Update the profile
PUT {{host}}/api/v1/users/me
Authorization: Bearer {{userToken}}
Content-Type: application/json

{ "fullName": "Test Customer", "email": "customer@example.com" }

### U5. Check it changed
GET {{host}}/api/v1/users/me
Authorization: Bearer {{userToken}}

###############################################################
# REFRESH (when the access token expires)
###############################################################

### R1. Get a new access token
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{userLogin.response.body.refreshToken}}", "deviceId": "user-phone-1" }



### Create or change a user's role (admin only)
POST {{host}}/api/v1/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "phoneNumber": "+2348012345678", "role": "Rider", "fullName": "Test Rider" }


### List users (filters are optional)
GET {{host}}/api/v1/admin/users?page=1&pageSize=20&role=Customer&q=0801
Authorization: Bearer {{adminToken}}

### One user
GET {{host}}/api/v1/admin/users/USER-ID
Authorization: Bearer {{adminToken}}

### Change a role
PUT {{host}}/api/v1/admin/users/USER-ID/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "role": "Merchant" }

### Deactivate
PUT {{host}}/api/v1/admin/users/USER-ID/deactivate
Authorization: Bearer {{adminToken}}